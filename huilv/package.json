{
  "name": "huilv",
  "private": true,
  "version": "1.0.0",
  "description": "简汇：极简的多币种汇率对比与换算 PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --mode single",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "icons": "node scripts/make-icons.mjs",
    "flags": "node scripts/gen-flags.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "deploy": "npm run build && node scripts/worker-files.mjs && tsc -p tsconfig.worker.json && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "circle-flags": "2.8.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.150.0"
  }
}
