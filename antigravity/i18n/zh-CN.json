 "patterns": [
  {
   "re": "^(\\d+) ?(?:s|sec|secs|second|seconds) ago$",
   "to": "$1 秒前"
  },
  {
   "re": "^(\\d+) ?(?:m|min|mins|minute|minutes) ago$",
   "to": "$1 分钟前"
  },
  {
   "re": "^(\\d+) ?(?:h|hr|hrs|hour|hours) ago$",
   "to": "$1 小时前"
  },
  {
   "re": "^(\\d+) ?(?:d|day|days) ago$",
   "to": "$1 天前"
  },
  {
   "re": "^(\\d+) ?(?:w|wk|wks|week|weeks) ago$",
   "to": "$1 周前"
  },
  {
   "re": "^(\\d+) ?(?:mo|mos|month|months) ago$",
   "to": "$1 个月前"
  },
  {
   "re": "^(\\d+) ?(?:y|yr|yrs|year|years) ago$",
   "to": "$1 年前"
  },
  {
   "re": "^in (\\d+) ?(?:s|sec|secs|seconds?)$",
   "to": "$1 秒后"
  },
  {
   "re": "^in (\\d+) ?(?:m|min|mins|minutes?)$",
   "to": "$1 分钟后"
  },
  {
   "re": "^in (\\d+) ?(?:h|hr|hrs|hours?)$",
   "to": "$1 小时后"
  },
  {
