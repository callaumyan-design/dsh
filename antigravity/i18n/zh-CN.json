   "to": "$1 小时 $2 分 $3 秒"
  },
  {
   "re": "^(\\d+)h (\\d+)m$",
   "to": "$1 小时 $2 分"
  },
  {
   "re": "^(\\d+)m (\\d+)s$",
   "to": "$1 分 $2 秒"
  },
