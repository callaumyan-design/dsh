{
  "name": "soulpet",
  "productName": "SoulPet",
  "version": "0.3.0",
  "description": "灵宠 SoulPet —— 可自定义形象、带养成系统、接入大模型并拥有长期记忆的桌面电子宠物",
  "main": "out/main/index.js",
  "author": "callaumyan-design",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:assets": "node scripts/gen-assets.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@pixi/unsafe-eval": "^6.5.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "homepage": "https://github.com/callaumyan-design/dsh/tree/desktop-pet"
}
