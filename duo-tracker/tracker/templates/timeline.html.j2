<!doctype html>
<html lang="zh-CN">
<head>
<title>Duo 适配时间线</title>
{% include "_style.html.j2" %}
<style>.day{border-left:2px solid var(--grid);padding:0 0 8px 16px;margin-left:6px}.day h2{font-size:16px;margin:0 0 6px}</style>
</head>
<body>
{% import "_macros.html.j2" as m %}
<div class="wrap">
<header class="top"><h1>历史时间线</h1>
  <nav class="tabs"><a href="{{ latest }}/daily.html">最新日报</a><a href="{{ latest }}/all.html">全量总表</a></nav></header>
<p class="sub">每天的综合判定变化（含“证据变了但无新版本、维持原判定”的记录）。完整历史保存在 SQLite 的 verdicts / observations / versions 表中。</p>
<section class="card">
  <div class="scroll"><table><thead><tr><th>日期</th><th class="num">跟踪 App</th><th class="num">已适配</th><th class="num">新版本</th><th class="num">新版本含 Duo 关键词</th><th class="num">状态变化</th><th></th></tr></thead><tbody>
  {% for d in days|reverse %}<tr><td>{{ d.run_date }}</td><td class="num">{{ d.n }}</td><td class="num">{{ d.ad }}</td>
    <td class="num">{{ versions.get(d.run_date, {}).get('n', 0) }}</td><td class="num">{{ versions.get(d.run_date, {}).get('hits', 0) }}</td>
    <td class="num">{{ events.get(d.run_date, [])|selectattr('held','equalto',0)|list|length }}</td><td><a href="{{ d.run_date }}/daily.html">日报</a></td></tr>{% endfor %}
  </tbody></table></div>
</section>
{% for date, evs in events.items() %}
<section class="card"><div class="day"><h2>{{ date }}</h2>
  <div class="scroll"><table><thead><tr><th>App</th><th>变化</th><th>证据</th></tr></thead><tbody>
  {% for e in evs %}<tr><td><a href="https://apps.apple.com/{{ (e.regions or 'cn').split(',')[0] }}/app/id{{ e.id }}" target="_blank" rel="noopener">{{ e.name }}</a> <span class="tag">{{ KIND_LABEL[e.kind] }}</span></td>
    <td style="white-space:nowrap">{% if e.held %}{{ m.pill(e.status) }} <span class="muted small">维持（证据给出 {{ STATUS_LABEL.get(e.proposed, e.proposed) }}，无新版本）</span>{% else %}{{ m.pill(e.prev) }} → {{ m.pill(e.status) }}{% endif %}</td>
    <td>{{ m.claims(e.claims, True) }}</td></tr>{% endfor %}
  </tbody></table></div></div></section>
{% else %}
<section class="card"><p class="muted">还没有状态变化记录（首次运行只建立初始判定；之后每天的变化会出现在这里）。</p></section>
{% endfor %}
</div>
</body>
</html>
