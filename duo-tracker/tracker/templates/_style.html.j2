<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{
  --page:#f9f9f7; --surface:#fcfcfb; --ink:#0b0b0b; --ink2:#52514e; --muted:#898781;
  --grid:#e1e0d9; --axis:#c3c2b7; --border:rgba(11,11,11,.10);
  --s1:#2a78d6; --s2:#eb6834;
  --good:#0ca30c; --good-ink:#006300; --warn:#fab219; --serious:#ec835a; --critical:#d03b3b; --violet:#6250d6;
  --chip:#f0efea; --link:#1c5cab;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --page:#0d0d0d; --surface:#1a1a19; --ink:#f0efec; --ink2:#c3c2b7; --muted:#898781;
    --grid:#2c2c2a; --axis:#383835; --border:rgba(255,255,255,.10);
    --s1:#3987e5; --s2:#d95926; --good-ink:#0ca30c; --violet:#9085e9; --chip:#262624; --link:#86b6ef;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --page:#0d0d0d; --surface:#1a1a19; --ink:#f0efec; --ink2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --border:rgba(255,255,255,.10);
  --s1:#3987e5; --s2:#d95926; --good-ink:#0ca30c; --violet:#9085e9; --chip:#262624; --link:#86b6ef;
  color-scheme: dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);font:14px/1.55 -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Segoe UI",sans-serif}
a{color:var(--link);text-decoration:none} a:hover{text-decoration:underline}
.wrap{max-width:1180px;margin:0 auto;padding:24px 16px 64px}
header.top{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 20px;margin-bottom:8px}
header.top h1{font-size:24px;margin:0;letter-spacing:-.01em}
nav.tabs{display:flex;gap:14px;font-size:13px;color:var(--ink2)}
.sub{color:var(--ink2);font-size:13px;margin:0 0 20px}
section.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin:16px 0}
section.card>h2{font-size:17px;margin:0 0 4px} .hint{color:var(--muted);font-size:12.5px;margin:0 0 12px}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--grid);vertical-align:top}
th{color:var(--ink2);font-weight:600;font-size:12px;white-space:nowrap;position:sticky;top:0;background:var(--surface)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.scroll{overflow-x:auto}
.pill{display:inline-flex;align-items:center;gap:5px;padding:1px 8px;border-radius:999px;font-size:12px;white-space:nowrap;background:var(--chip);color:var(--ink)}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--muted)}
.st-perfect::before{background:var(--good)} .st-full::before{background:var(--good)}
.st-partial::before{background:var(--warn)} .st-none::before{background:var(--critical)}
.st-disputed::before{background:var(--violet)} .st-unknown::before{background:var(--axis)}
.st-perfect{font-weight:600}
.tag{display:inline-block;padding:0 6px;border-radius:4px;font-size:11.5px;background:var(--chip);color:var(--ink2);margin:1px 2px 1px 0}
.tag.hit{background:transparent;border:1px solid var(--good);color:var(--good-ink)}
.tag.weak{background:transparent;border:1px dashed var(--axis)}
.muted{color:var(--muted)} .ink2{color:var(--ink2)} .small{font-size:12px}
.claims{margin:4px 0 0;padding:0;list-style:none}
.claims li{font-size:12.5px;color:var(--ink2);padding:2px 0}
.claims li b{color:var(--ink);font-weight:600}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:8px 0 4px}
.kpi{border:1px solid var(--border);border-radius:10px;padding:10px 12px;background:var(--surface)}
.kpi .v{font-size:24px;font-weight:650;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.kpi .l{font-size:12px;color:var(--ink2)}
details>summary{cursor:pointer;color:var(--ink2);font-size:13px}
.notes{font-size:12.5px;color:var(--ink2);padding-left:18px}
.ok{color:var(--good-ink)} .bad{color:var(--critical)}
.filters{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;margin:0 0 12px}
.filters label{font-size:12.5px;color:var(--ink2);display:flex;gap:6px;align-items:center}
select,input[type=search]{font:inherit;font-size:13px;padding:5px 8px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--ink)}
input[type=search]{min-width:200px}
.notesbox{white-space:pre-wrap;font-size:12px;color:var(--ink2);max-height:7.5em;overflow:hidden}
@media (max-width:640px){ .hide-m{display:none} th,td{padding:6px 5px} }
</style>
