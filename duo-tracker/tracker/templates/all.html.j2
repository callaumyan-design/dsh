<!doctype html>
<html lang="zh-CN">
<head>
<title>Duo 适配总表 {{ date }}</title>
{% include "_style.html.j2" %}
<style>
tr.app{cursor:pointer} tr.app:hover td{background:var(--chip)}
tr.detail td{background:var(--page)}
.count{font-size:13px;color:var(--ink2)}
</style>
</head>
<body>
<div class="wrap">
<header class="top"><h1>全量状态总表 · {{ date }}</h1>
  <nav class="tabs"><a href="daily.html">日报</a><a href="../timeline.html">历史时间线</a><a href="status.csv">CSV</a></nav></header>
<p class="sub">点击一行查看各来源证据。名次：App 为总榜（不含游戏）名次，游戏为游戏榜名次。</p>
<section class="card">
  <div class="filters">
    <label>状态 <select id="f-status"><option value="">全部</option><option value="adapted">已适配（全部级别）</option>
      {% for s in ['perfect','full','partial','none','disputed','unknown'] %}<option value="{{ s }}">{{ STATUS_LABEL[s] }}</option>{% endfor %}</select></label>
    <label>类型 <select id="f-kind"><option value="">全部</option><option value="app">App</option><option value="game">游戏</option></select></label>
    <label>地区 <select id="f-region"><option value="">全部</option><option value="cn">中国</option><option value="us">美国</option></select></label>
    <label>榜单 <select id="f-chart"><option value="">全部（含自定义名单）</option><option value="top-free">免费榜 Top 200</option><option value="top-paid">付费榜 Top 200</option><option value="watch">自定义名单</option></select></label>
    <label><input type="search" id="f-q" placeholder="搜索名称 / 开发者 / id"></label>
    <span class="count" id="count"></span>
  </div>
  <div class="scroll"><table>
    <thead><tr><th>App</th><th>类型</th><th>地区</th><th>状态</th><th class="hide-m">置信度</th><th class="num hide-m">免费榜</th><th class="num hide-m">付费榜</th><th class="hide-m">版本</th><th class="hide-m">来源</th></tr></thead>
    <tbody id="rows"></tbody></table></div>
</section>
</div>
<script>
const APPS = {{ apps | tojson_safe }};
const SL = {{ STATUS_LABEL | tojson_safe }}, SRC = {{ SOURCE_LABEL | tojson_safe }}, CL = {{ CONF_LABEL | tojson_safe }};
const RL = {cn: "中国", us: "美国"}, KL = {app: "App", game: "游戏"};
const ADAPTED = new Set(["perfect", "full", "partial"]);
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
const pill = s => `<span class="pill st-${s || "unknown"}">${SL[s || "unknown"] || s}</span>`;
const bestRank = (a, chart, region) => { const v = Object.entries(a.ranks).filter(([k]) => k.endsWith(":" + chart) && (!region || k.startsWith(region + ":"))).map(([, v]) => v); return v.length ? Math.min(...v) : null; };
const els = id => document.getElementById(id);
let open = new Set();
function render() {
  const st = els("f-status").value, kd = els("f-kind").value, rg = els("f-region").value, ch = els("f-chart").value, q = els("f-q").value.trim().toLowerCase();
  let list = APPS.filter(a => (!st || (st === "adapted" ? ADAPTED.has(a.status) : a.status === st))
    && (!kd || a.kind === kd) && (!rg || a.regions.includes(rg))
    && (!ch || (ch === "watch" ? (a.track || "").includes("watchlist") : bestRank(a, ch, rg) !== null))
    && (!q || [a.name, a.name_cn, a.name_us, a.developer, a.id].some(v => (v || "").toLowerCase().includes(q))));
  list.sort((a, b) => (bestRank(a, "top-free", rg) ?? 999) - (bestRank(b, "top-free", rg) ?? 999) || (bestRank(a, "top-paid", rg) ?? 999) - (bestRank(b, "top-paid", rg) ?? 999) || (a.name || "").localeCompare(b.name || ""));
  els("count").textContent = `${list.length} 个 · 已适配 ${list.filter(a => ADAPTED.has(a.status)).length}`;
  els("rows").innerHTML = list.map(a => {
    const srcs = a.claims.filter(c => c.status !== "unknown").map(c => `<span class="tag">${esc(SRC[c.source] || c.source)}:${esc(SL[c.status])}</span>`).join("");
    let h = `<tr class="app" data-id="${a.id}"><td><a href="https://apps.apple.com/${a.regions[0] || "cn"}/app/id${a.id}" target="_blank" rel="noopener">${esc(a.name)}</a>${a.name_us && a.name_cn && a.name_us !== a.name_cn ? `<div class="small muted">${esc(a.name_us)}</div>` : ""}</td>
      <td>${KL[a.kind]}</td><td>${a.regions.filter(Boolean).map(r => RL[r] || r).join("/")}</td><td>${pill(a.status)}${a.held ? ' <span class="tag" title="证据给出 ' + esc(SL[a.proposed] || a.proposed) + '，但无新版本">维持</span>' : ""}</td>
      <td class="hide-m small">${esc(CL[a.confidence] || a.confidence)}</td><td class="num hide-m">${bestRank(a, "top-free", rg) ?? ""}</td><td class="num hide-m">${bestRank(a, "top-paid", rg) ?? ""}</td>
      <td class="hide-m small muted">${esc((a.version || "").replace(/;/g, " "))}</td><td class="hide-m">${srcs}</td></tr>`;
    if (open.has(a.id)) {
      h += `<tr class="detail"><td colspan="9"><div class="small ink2">${esc(a.reason)}</div><ul class="claims">${a.claims.map(c => `<li><b>${esc(SRC[c.source] || c.source)}</b>：${esc(SL[c.status] || c.status)}${c.raw_status ? ` <span class="muted">（${esc(c.raw_status)}）</span>` : ""}${c.votes ? ` <span class="tag">+${c.votes.fit}/−${c.votes.unfit}</span>` : ""}${c.stale ? ' <span class="tag">早于当前版本</span>' : ""}${c.observed_at ? ` <span class="muted small">${esc(c.observed_at.slice(0, 10))}</span>` : ""} — ${esc((c.evidence || "").slice(0, 300))}${c.url ? ` <a href="${esc(c.url)}" target="_blank" rel="noopener">链接</a>` : ""}</li>`).join("") || "<li>没有任何来源的记录</li>"}</ul></td></tr>`;
    }
    return h;
  }).join("");
}
["f-status", "f-kind", "f-region", "f-chart"].forEach(id => els(id).addEventListener("change", render));
els("f-q").addEventListener("input", render);
els("rows").addEventListener("click", e => {
  if (e.target.closest("a")) return;
  const tr = e.target.closest("tr.app"); if (!tr) return;
  const id = tr.dataset.id; open.has(id) ? open.delete(id) : open.add(id); render();
});
const qs = new URLSearchParams(location.search); for (const k of ["status", "kind", "region", "chart", "q"]) if (qs.get(k)) els("f-" + k).value = qs.get(k);
render();
</script>
</body>
</html>
