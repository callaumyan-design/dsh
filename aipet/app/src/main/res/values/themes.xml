<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AiPet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/leaf</item>
        <item name="colorSecondaryContainer">@color/leaf_container</item>
        <item name="colorOnSecondaryContainer">@color/leaf_on_container</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Hint">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>
</resources>
